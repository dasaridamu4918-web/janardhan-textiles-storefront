# Janardhan Textiles — Environment Configuration Template
# Copy to .env (never commit .env to git) and fill in real values.

# Application Environment: development | production
APP_ENV=development

# Admin Initial Credentials (required on first database seed)
ADMIN_INITIAL_EMAIL=admin@janardhantextiles.com
ADMIN_INITIAL_PASSWORD=

# Session & Signing Secret (32+ random hex bytes recommended)
JWT_SECRET=

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4000,https://janardhan-textiles-storefront.vercel.app

# Managed Database (Production on Vercel / Cloud)
# Set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN for LibSQL/Turso HTTP persistence,
# or DATABASE_URL for PostgreSQL. Falls back to local janardan_textiles.db in dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_URL=

# Razorpay Payment Gateway (Leave blank to keep Online Payment disabled with honest 501 notice)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gemini Nano Banana 2 Pro Server-Side API Key
GEMINI_API_KEY=
